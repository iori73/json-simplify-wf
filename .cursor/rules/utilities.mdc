## Type Safety

### Use `unknown` Instead of `any`
```typescript
// Good
export function getJsonType(value: unknown): JsonValueType {
    if (value === null) return 'null';
    if (Array.isArray(value)) return 'array';
    return typeof value as JsonValueType;
}

// Bad
export function getJsonType(value: any): string {
```

### Explicit Return Types
Always specify return types:

```typescript
// Good
export function prettifyJson(jsonString: string): string { ... }
export function jsonToTree(json: unknown, key?: string): TreeNode { ... }

// Bad
export function prettifyJson(jsonString: string) { ... }  // Implicit return type
```

### Type Assertions
Use type assertions sparingly and with care:

```typescript
// Acceptable: After type check
if (type === 'object' && json !== null) {
    const obj = json as Record<string, unknown>;
    // ...
}

// Bad: Unsafe assertion
const obj = json as Record<string, unknown>;  // No type check
```

## Error Handling

### Return Result Objects
For functions that can fail, return result objects instead of throwing:

```typescript
// Good: Result object
export function validateJson(jsonString: string): { isValid: boolean; error: string | null } {
    try {
        JSON.parse(jsonString);
        return { isValid: true, error: null };
    } catch (error) {
        const errorMessage = error instanceof Error ? error.message : 'Invalid JSON';
        return { isValid: false, error: errorMessage };
    }
}

// Also acceptable: Return original on failure
export function prettifyJson(jsonString: string): string {
    try {
        const parsed = JSON.parse(jsonString);
        return JSON.stringify(parsed, null, 2);
    } catch {
        return jsonString;  // Return original if invalid
    }
}
```

### Type-Safe Error Handling
```typescript
// Good
catch (error) {
    const errorMessage = error instanceof Error ? error.message : 'Unknown error';
}

// Bad
catch (error) {
    const errorMessage = error.message;  // TypeScript error
}
```

## Naming Conventions

### Functions
- Use camelCase: `validateJson`, `getJsonType`, `buildPath`
- Start with verb: `get`, `validate`, `build`, `format`, `search`, `is`
- Boolean functions use `is`: `isLeafNode`

### Types
- PascalCase: `TreeNode`, `JsonValueType`, `SearchMatch`
- Interface for objects: `interface TreeNode { ... }`
- Type alias for unions: `type JsonValueType = 'string' | 'number' | ...`

## File Organization

### One Concern Per File
```
lib/
├── types.ts          # Type definitions only
├── jsonUtils.ts      # JSON parsing/validation/transformation
├── urlUtils.ts       # URL encoding/decoding for sharing
├── clipboardUtils.ts # Clipboard operations
└── ThemeContext.tsx  # Theme state management
```

### Export Pattern
Export individual functions, not default export:

```typescript
// Good
export function validateJson() { ... }
export function prettifyJson() { ... }

// Bad
export default {
    validateJson,
    prettifyJson,
};
```

## Recursion Pattern

For tree traversal, use inner helper functions:

```typescript
export function searchTreeByKey(node: TreeNode, searchTerm: string): string[] {
    const matches: string[] = [];
    const lowerSearch = searchTerm.toLowerCase();

    // Inner recursive function
    function traverse(currentNode: TreeNode) {
        if (currentNode.key.toLowerCase().includes(lowerSearch)) {
            matches.push(currentNode.path);
        }
        if (currentNode.children) {
            currentNode.children.forEach(traverse);
        }
    }

    traverse(node);
    return matches;
}
```

## Testing Considerations

Functions should be written to be easily testable:
- No global state dependencies
- No DOM manipulation (except in specific utils like clipboard)
- Clear inputs and outputs
- Deterministic behavior
